# Copy to .env for local development. NEVER commit the real .env file.
SECRET_KEY=replace_with_a_secure_random_value
DATABASE_URL=replace_with_supabase_postgresql_connection_string
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=replace_with_supported_model_name
APP_TIMEZONE=Asia/Kolkata
FLASK_ENV=production
# For quick local testing without Supabase: set FLASK_ENV=development and leave DATABASE_URL empty (uses local SQLite).

# Optional
# ADMIN_API_TOKEN=replace_with_long_random_token   # enables POST /api/admin/generate-questions
# QUESTIONS_PER_GAME=10
# ALL_QUIZ_QUESTIONS=56
# DAILY_QUESTION_COUNT=50
# RATELIMIT_STORAGE_URI=memory://
